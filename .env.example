# Named API keys: principal:scopes:key, comma- or newline-separated.
# The approver written into the audit log is derived from the key that
# authenticated the call, so POST /approve needs a key with the approve scope.
# Scopes: submit, approve, or submit+approve. Keys must not contain a comma.
API_KEYS=alice@yourorg.com:submit+approve:replace_with_a_long_random_key
# Legacy single shared key. Still authenticates and may submit, but it names
# nobody, so it cannot approve. Leave both blank for local dev mode (no auth).
API_KEY=

# Set LLM_PROVIDER to "gemini" (default) or "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=http://localhost:3000
MEM0_API_KEY=your_mem0_key_here
JIRA_URL=https://yourorg.atlassian.net
JIRA_EMAIL=your_email@company.com
JIRA_TOKEN=your_jira_api_token
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
